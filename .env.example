MONGODB_URI=
MONGODB_DB_NAME=mzpmi

ADMIN_PASSWORD=

CLOUDINARY_URL=
# Or use these instead of CLOUDINARY_URL:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Free-plan upload guardrails. These defaults are conservative for Vercel Hobby.
# /api/upload is the fallback path and should stay small because Vercel handles the file body.
UPLOAD_MAX_FILE_MB=4
UPLOAD_DAILY_LIMIT_MB=25
UPLOAD_WEEKLY_LIMIT_MB=100
UPLOAD_DAILY_LIMIT_COUNT=20

# Direct Cloudinary uploads only send a small signature request through Vercel.
UPLOAD_DIRECT_MAX_FILE_MB=100
UPLOAD_DIRECT_DAILY_LIMIT_MB=250
UPLOAD_DIRECT_WEEKLY_LIMIT_MB=1000
CLOUDINARY_UPLOAD_FOLDER=mzbc
